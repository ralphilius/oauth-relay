{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anys3-oauth-relay",
  "main": "src/index.ts",
  "account_id": "99fb96dc4e6b0e7db5a2c77a5e26a329",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      // Custom domain for the OAuth relay. Add this hostname in the
      // Cloudflare dashboard before deploying.
      "pattern": "oauth-relay.ralphilius.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // App registry: appId -> { allowedOriginSuffix }. Allowed suffixes are the
    // worker's workers.dev hostname (e.g. "sheetson.ralphilius.workers.dev"),
    // so per-version previews like <prefix>-sheetson.ralphilius.workers.dev
    // match while the bare worker URL is rejected. The shared signing key is
    // set via `wrangler secret put OAUTH_RELAY_SIGNING_KEY` and is NOT here.
    "APPS": "{\"anys3\":{\"allowedOriginSuffix\":\"anys3-dashboard.ralphilius.workers.dev\"},\"sheetson\":{\"allowedOriginSuffix\":\"sheetson.ralphilius.workers.dev\"}}"
  }
}
